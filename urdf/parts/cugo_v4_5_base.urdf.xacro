<?xml version="1.0"?>
<robot name="cugo" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="cugo_base">

    <link name="base_footprint" />
    <link name="base_link">
      <visual>
        <geometry>
          <box size=" 0.590  0.260  0.120"/>
        </geometry>
        <origin xyz=" 0.000  0.000 -0.060" rpy="0.000 0.000 0.000"/>
      </visual>
      <visual>
        <geometry>
          <box size=" 0.165  0.562  0.085"/>
        </geometry>
        <origin xyz="-0.2125 0.000  0.0425" rpy="0.000 0.000 0.000"/>
      </visual>

      <collision>
        <geometry>
          <box size=" 0.590  0.260  0.120"/>
        </geometry>
        <origin xyz=" 0.000  0.000 -0.060" rpy="0.000 0.000 0.000"/>
      </collision>
      <collision>
        <geometry>
          <box size=" 0.165  0.562  0.085"/>
        </geometry>
        <origin xyz="-0.2125 0.000  0.0425" rpy="0.000 0.000 0.000"/>
      </collision>
    </link>

    <joint name="base_footprint_to_base_link_joint" type="fixed">
      <parent link="base_footprint"/>
      <child link="base_link"/>
      <origin xyz=" 0.000  0.000  0.170" rpy="0.000 0.000 0.000" />
    </joint>

    <link name="left_crawler_link">
      <visual>
        <geometry>
          <cylinder radius="0.03835" length="0.120"/>
        </geometry>
        <origin rpy="${pi/2} 0.000 0.000" xyz="0.000 0.000 0.000"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="0.03835" length="0.120"/>
        </geometry>
        <origin rpy="${pi/2} 0.000 0.000" xyz="0.000 0.000 0.000"/>
      </collision>
    </link>

    <joint name="base_to_left_crawler_joint" type="continuous">
      <origin xyz="0.000 0.130 -0.13165" rpy="0.000 0.000 0.000"/>
      <parent link="base_link"/>
      <child link="left_crawler_link"/>
      <axis xyz="0 1 0"/>
    </joint>

    <link name="right_crawler_link">
      <visual>
        <geometry>
          <cylinder radius="0.03835" length="0.120"/>
        </geometry>
        <origin rpy="${pi/2} 0.000 0.000" xyz="0.000 0.000 0.000"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="0.03835" length="0.120"/>
        </geometry>
        <origin rpy="${pi/2} 0.000 0.000" xyz="0.000 0.000 0.000"/>
      </collision>
    </link>

    <joint name="base_to_right_crawler_joint" type="continuous">
      <origin xyz="0.000 -0.130 -0.13165" rpy="0.000 0.000 0.000"/>
      <parent link="base_link"/>
      <child link="right_crawler_link"/>
      <axis xyz="0 1 0"/>
    </joint>

  </xacro:macro>

</robot>
